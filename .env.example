# Copy this file to .env for local development.
# Never commit the generated .env file or reuse its secrets elsewhere.
APP_ENV=development
APP_NAME="SecureFlow API"
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./secureflow.db

# Generate locally with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ISSUER=secureflow
JWT_AUDIENCE=secureflow-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
