# Copy this file to .env for local development.
# Never commit the generated .env file or reuse its secrets elsewhere.
APP_ENV=development
APP_NAME="SecureFlow API"
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./secureflow.db

# Configure exactly one JWT signing-key source.
# Local development usually uses JWT_SECRET_KEY:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Or point to a mounted secret file in an orchestrated environment:
# JWT_SECRET_KEY_FILE=/var/run/secrets/secureflow/jwt-secret-key

JWT_ISSUER=secureflow
JWT_AUDIENCE=secureflow-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
